FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM node:20-alpine AS runner
WORKDIR /app

RUN addgroup -g 1001 nodejs && adduser -u 1001 -G nodejs -S nodejs

COPY package*.json ./
RUN npm ci --omit=dev

COPY --chown=nodejs:nodejs . .

USER nodejs
EXPOSE 3000
ENV NODE_ENV=production

CMD ["node", "server.js"]